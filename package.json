{
  "name": "fm24-companion",
  "version": "0.1.0",
  "description": "FM24 Companion",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "node --max-old-space-size=4096 node_modules/vitest/vitest.mjs run",
    "typecheck": "tsc --noEmit",
    "import": "node --max-old-space-size=4096 src/importer/run.ts",
    "uid-check": "node src/importer/compare.ts",
    "dev": "vite",
    "build:ui": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "electron:smoke": "node scripts/build-electron.mjs && electron . --smoke",
    "electron:dev": "node scripts/electron-dev.mjs",
    "dist": "npm run build:ui && npm run build:electron && electron-builder --win nsis",
    "electron:smoke-ui": "npm run build:ui && node scripts/build-electron.mjs && electron . --smoke-ui"
  },
  "private": true,
  "type": "module",
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "license": "GPL-3.0-only",
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "main": "dist-electron/main.cjs",
  "author": "Gaspar Rivollier"
}
